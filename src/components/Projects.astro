---
// Projects as an editorial index: one row per project. Hover a row for a
// floating "index card" with its headline result (fine pointers only); click
// or tap a row to expand the write-up (native <details>, works without JS).
import { projects } from '../data/projects';
import { skills } from '../data/site';
import Reveal from './Reveal.astro';
import ArrowUpRight from './ArrowUpRight.astro';

const pad2 = (n: number) => String(n).padStart(2, '0');
const tilts = [-3, 2.5, -1.5, 3];
---

<section id="projects" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-28">
    <Reveal class="mb-12 md:mb-16">
      <p class="eyebrow">
        Selected Projects <span class="ml-1 opacity-70">({pad2(projects.length)})</span>
      </p>
      <div class="mt-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <h2 class="max-w-2xl font-serif text-display">Research from my time at NYU.</h2>
        <p class="text-sm text-ink-faint">
          <span class="hidden [@media(hover:hover)]:inline">Hover to preview, click to open.</span>
          <span class="[@media(hover:hover)]:hidden">Tap a project to open it.</span>
        </p>
      </div>
    </Reveal>

    <ol id="project-list" class="proj-list border-b border-line">
      {projects.map((p, i) => (
        <li>
          <Reveal delay={i * 60}>
            <details
              class="group/p border-t border-line"
              data-index={pad2(i + 1)}
              data-year={p.year}
              data-value={p.highlight.value}
              data-label={p.highlight.label}
              data-tilt={tilts[i % tilts.length]}
              data-media={p.media?.src}
              data-poster={p.media?.poster}
            >
              <summary class="group/s relative isolate grid cursor-pointer list-none grid-cols-[3rem_1fr_auto] items-center gap-x-4 py-6 outline-offset-4 md:grid-cols-[5rem_1fr_auto] md:gap-x-8 md:py-8 [&::-webkit-details-marker]:hidden">
                {/* Highlight band that sweeps in from the left */}
                <span
                  class="absolute inset-y-1 -inset-x-3 -z-10 origin-left scale-x-0 rounded-xl bg-paper-2 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/s:scale-x-100 group-focus-visible/s:scale-x-100 md:-inset-x-5"
                  aria-hidden="true"
                />
                <span class="text-sm tabular-nums text-ink-faint">{p.year}</span>
                <span class="font-serif text-ink transition-[translate,color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/s:translate-x-1.5 group-open/p:text-accent text-title">
                  {p.title}
                </span>
                <span
                  class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-ink-soft transition-[rotate,border-color,color,background-color] duration-300 group-hover/s:border-accent group-hover/s:text-accent group-open/p:rotate-45 group-open/p:border-accent group-open/p:bg-accent group-open/p:text-paper"
                  aria-hidden="true"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path
                      d="M7 1.5v11M1.5 7h11"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </summary>

              <div class="grid grid-cols-[3rem_1fr] gap-x-4 pb-9 md:grid-cols-[5rem_1fr] md:gap-x-8">
                <div
                  class={`col-start-2 ${p.media ? 'md:grid md:grid-cols-[minmax(0,1fr)_15rem] md:gap-10 lg:grid-cols-[minmax(0,1fr)_19rem]' : 'max-w-2xl'}`}
                >
                  <div class="max-w-2xl">
                    <p class="text-[1.05rem] leading-relaxed text-ink-soft">{p.blurb}</p>
                    <p class="mt-4 font-serif text-lg text-ink">
                      <span class="text-accent">{p.highlight.value}</span>{' '}
                      <span class="text-ink-faint">· {p.highlight.label}</span>
                    </p>
                    <ul class="mt-5 flex flex-wrap gap-2">
                      {p.stack.map((t) => (
                        <li class="chip">{t}</li>
                      ))}
                    </ul>
                    {(p.code || p.demo) && (
                      <div class="mt-6 flex items-center gap-5 text-sm font-medium">
                        {p.code && (
                          <a
                            href={p.code}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-underline inline-flex items-center gap-1.5 text-ink"
                          >
                            Code <ArrowUpRight />
                          </a>
                        )}
                        {p.demo && (
                          <a
                            href={p.demo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-underline inline-flex items-center gap-1.5 text-ink"
                          >
                            Demo <ArrowUpRight />
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                  {p.media && (
                    <figure class="mt-8 max-w-sm md:mt-1 md:max-w-none">
                      <picture>
                        {p.media.poster && (
                          <source
                            media="(prefers-reduced-motion: reduce)"
                            srcset={p.media.poster}
                          />
                        )}
                        <img
                          src={p.media.src}
                          alt={p.media.alt}
                          width={p.media.width}
                          height={p.media.height}
                          loading="lazy"
                          decoding="async"
                          class="h-auto w-full rounded-xl border border-line bg-black shadow-[0_18px_40px_-24px_rgba(25,24,23,0.5)]"
                        />
                      </picture>
                      {p.media.caption && (
                        <figcaption class="mt-3 text-xs leading-snug text-ink-faint">
                          {p.media.caption}
                        </figcaption>
                      )}
                    </figure>
                  )}
                </div>
              </div>
            </details>
          </Reveal>
        </li>
      ))}
    </ol>

    <!-- Toolkit: what I work with now, not just at NYU. Same rail as Experience. -->
    <Reveal class="mt-16 grid gap-6 md:mt-20 md:grid-cols-[0.8fr_2fr] md:gap-12">
      <h3 class="eyebrow md:pt-1">Toolkit</h3>
      <div class="space-y-4">
        {skills.map((s) => (
          <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:gap-5">
            <span class="w-28 shrink-0 text-sm text-ink-faint">{s.group}</span>
            <span class="text-[0.98rem] leading-relaxed text-ink-soft">{s.items.join(' · ')}</span>
          </div>
        ))}
      </div>
    </Reveal>
  </div>

  <!-- Floating index card (decorative; same info is in each expanded row) -->
  <div id="proj-card" class="pointer-events-none fixed top-0 left-0 z-40 hidden" aria-hidden="true">
    <div
      id="proj-card-inner"
      class="w-64 scale-90 rounded-xl border border-line bg-paper p-5 opacity-0 shadow-[0_18px_40px_-18px_rgba(25,24,23,0.45)] transition-[opacity,scale,rotate] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
    >
      <div class="flex items-center justify-between border-b border-dashed border-line pb-2 font-mono text-[0.7rem] text-ink-faint">
        <span>
          No. <span data-slot="index"></span>
        </span>
        <span data-slot="year"></span>
      </div>
      <div data-slot="body">
        <img
          data-slot="media"
          alt=""
          class="mt-3 hidden aspect-square w-full rounded-md border border-line bg-black"
        />
        <p data-slot="value" class="mt-3 font-serif text-[1.9rem] leading-tight text-accent"></p>
        <p data-slot="label" class="mt-1 text-sm leading-snug text-ink-soft"></p>
      </div>
    </div>
  </div>
</section>

<script>
  const list = document.getElementById('project-list')!;
  const card = document.getElementById('proj-card')!;
  const inner = document.getElementById('proj-card-inner')!;
  const slot = (name: string) => card.querySelector<HTMLElement>(`[data-slot="${name}"]`)!;

  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  let active: HTMLDetailsElement | null = null;
  let raf = 0;
  const pos = { x: 0, y: 0 };
  const target = { x: 0, y: 0 };
  const OFFSET = 28;

  const place = (cx: number, cy: number) => {
    const w = inner.offsetWidth || 256;
    const h = inner.offsetHeight || 120;
    // Sit to the right of the cursor; flip left near the viewport edge.
    target.x = cx + OFFSET + w > innerWidth - 12 ? cx - OFFSET - w : cx + OFFSET;
    target.y = Math.min(Math.max(12, cy - h / 2), innerHeight - h - 12);
  };

  const tick = () => {
    const k = reduced.matches ? 1 : 0.2;
    pos.x += (target.x - pos.x) * k;
    pos.y += (target.y - pos.y) * k;
    card.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
    raf =
      Math.abs(target.x - pos.x) + Math.abs(target.y - pos.y) > 0.3
        ? requestAnimationFrame(tick)
        : 0;
  };
  const kick = () => {
    if (!raf) raf = requestAnimationFrame(tick);
  };

  const show = (d: HTMLDetailsElement, cx: number, cy: number) => {
    const wasHidden = !active;
    if (d !== active) {
      slot('index').textContent = d.dataset.index!;
      slot('year').textContent = d.dataset.year!;
      slot('value').textContent = d.dataset.value!;
      slot('label').textContent = d.dataset.label!;
      const media = slot('media') as HTMLImageElement;
      const src = reduced.matches ? d.dataset.poster || d.dataset.media : d.dataset.media;
      if (src) {
        if (media.getAttribute('src') !== src) media.src = src;
        media.classList.remove('hidden');
      } else {
        media.classList.add('hidden');
      }
      inner.style.rotate = `${d.dataset.tilt}deg`;
      if (!wasHidden && !reduced.matches) {
        slot('body').animate(
          [
            { opacity: 0, transform: 'translateY(6px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      }
      active = d;
    }
    place(cx, cy);
    if (wasHidden) {
      // Appear at the cursor instead of gliding in from the last position.
      pos.x = target.x;
      pos.y = target.y;
      card.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
      card.classList.remove('hidden');
      requestAnimationFrame(() => inner.classList.remove('opacity-0', 'scale-90'));
    }
    kick();
  };

  const hide = () => {
    if (!active) return;
    active = null;
    inner.classList.add('opacity-0', 'scale-90');
  };

  inner.addEventListener('transitionend', () => {
    if (!active) card.classList.add('hidden');
  });

  list.addEventListener('pointermove', (e) => {
    if (!finePointer.matches || e.pointerType !== 'mouse') return;
    const summary = (e.target as Element).closest('summary');
    const d = summary?.parentElement as HTMLDetailsElement | undefined;
    // Open rows already show the full write-up, so no card there.
    if (d && !d.open) show(d, e.clientX, e.clientY);
    else hide();
  });
  list.addEventListener('pointerleave', hide);
  window.addEventListener('scroll', hide, { passive: true });
  list.querySelectorAll('details').forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open && d === active) hide();
    }),
  );
</script>
