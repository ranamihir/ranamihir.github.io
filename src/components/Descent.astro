---
// Gradient descent behind the hero: contour lines of a loss surface whose
// minimum follows the cursor (or a tap), and a ball that descends it with
// momentum. Kept quiet on purpose: it starts at rest, and contours show only
// in a soft pool around the minimum.
// The terminal's `lr` command changes the learning rate. Decorative only
// (aria-hidden, no pointer events); the math lives in src/lib/descent.ts.
// Reduced motion: one static frame with the full descent path drawn in.
// Phones (below md, DESCENT_MEDIA) get none of it: the canvas is hidden and nothing runs.
---

<canvas
  id="descent"
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 hidden h-full w-full md:block [mask-image:linear-gradient(to_bottom,transparent,#000_18%,#000_82%,transparent)]"
></canvas>
<p
  id="descent-stats"
  aria-hidden="true"
  class="pointer-events-none absolute right-6 bottom-5 hidden font-mono text-[0.7rem] text-ink-faint tabular-nums md:right-10 md:block"
></p>

<script>
  import {
    contours,
    DEFAULT_LR,
    DESCENT_MEDIA,
    LEVELS,
    loss,
    LR_EVENT,
    makeBumps,
    step,
    STEPS_PER_SECOND,
    type Ball,
    type Surface,
    type Vec,
  } from '../lib/descent';
  import { THEME_CHANGE_EVENT } from '../lib/theme';

  const canvas = document.getElementById('descent') as HTMLCanvasElement;
  const stats = document.getElementById('descent-stats')!;
  const hero = canvas.parentElement!;
  const ctx = canvas.getContext('2d')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = window.matchMedia(DESCENT_MEDIA);

  /** Contour grid spacing (CSS px). */
  const CELL = 18;
  /** Trail length in optimizer steps (~1 s). */
  const TRAIL = 30;
  /** Contour levels drawn in the accent colour: the innermost rings around the minimum. */
  const INNER_LEVELS = 2;
  /** Contours fade out over this radius around the minimum (hero heights)... */
  const POOL = 0.55;
  /** ...down to this opacity. */
  const POOL_EDGE = 0.1;
  /** How quickly the minimum glides to its new spot (1/s; higher = snappier). */
  const GLIDE = 10;

  let W = 0;
  let H = 0;
  let aspect = 1;
  let lr = DEFAULT_LR;
  let stepCount = 0;
  let colors = { line: '', accent: '' };

  // Resting spot when there's no cursor: the empty band at the bottom right.
  const home = (): Vec => ({ x: aspect * 0.72, y: Math.max(0.5, 1 - 56 / H) });

  const surface: Surface = { min: { x: 0, y: 0 }, bumps: [] };
  const ball: Ball = { p: { x: 0, y: 0 }, v: { x: 0, y: 0 } };
  let prev: Vec = ball.p;
  const trail: Vec[] = [];
  let mouse: Vec | null = null;
  let tap: Vec | null = null;
  const target = () => mouse ?? tap ?? home();

  // ---- sizing --------------------------------------------------------------
  let bumpsAspect = 0;
  function resize() {
    const r = hero.getBoundingClientRect();
    if (!wide.matches || !r.width || !r.height) return false;
    const first = !W;
    // Keep things where they are on screen (units are hero heights).
    const k = first ? 1 : H / r.height;
    W = r.width;
    H = r.height;
    aspect = W / H;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (first) {
      // Start at rest: nothing moves until the visitor's cursor enters the hero.
      surface.min = home();
      ball.p = { ...surface.min };
      prev = ball.p;
    } else {
      // Trail points and `prev` share objects with ball.p: scale each once.
      for (const v of new Set([surface.min, ball.p, prev, ...trail])) {
        v.x *= k;
        v.y *= k;
      }
    }
    if (Math.abs(aspect - bumpsAspect) / aspect > 0.15) {
      surface.bumps = makeBumps(Math.random, aspect);
      bumpsAspect = aspect;
    }
    contourKey = '';
    return true;
  }

  function readColors() {
    const css = getComputedStyle(document.documentElement);
    colors = {
      line: css.getPropertyValue('--color-line').trim(),
      accent: css.getPropertyValue('--color-accent').trim(),
    };
  }

  // ---- drawing -------------------------------------------------------------
  let contourKey = '';
  let outerPath = new Path2D();
  let innerPath = new Path2D();

  function buildContours() {
    const key = `${surface.min.x.toFixed(4)},${surface.min.y.toFixed(4)},${W},${H}`;
    if (key === contourKey) return;
    contourKey = key;
    const cols = Math.ceil(W / CELL);
    const rows = Math.ceil(H / CELL);
    const field = new Float32Array((cols + 1) * (rows + 1));
    for (let j = 0; j <= rows; j++)
      for (let i = 0; i <= cols; i++)
        field[j * (cols + 1) + i] = loss(surface, { x: (i * CELL) / H, y: (j * CELL) / H });
    // Inner rings: the lowest levels that actually appear around the minimum.
    const segs = contours(field, cols, rows, LEVELS);
    const present = segs.map((s, i) => (s.length && LEVELS[i] > 0 ? i : -1)).filter((i) => i >= 0);
    const inner = new Set(present.slice(0, INNER_LEVELS));
    outerPath = new Path2D();
    innerPath = new Path2D();
    segs.forEach((s, li) => {
      const path = inner.has(li) ? innerPath : outerPath;
      for (let n = 0; n < s.length; n += 4) {
        path.moveTo(s[n] * CELL, s[n + 1] * CELL);
        path.lineTo(s[n + 2] * CELL, s[n + 3] * CELL);
      }
    });
  }

  function draw(at: Vec) {
    buildContours();
    ctx.clearRect(0, 0, W, H);
    ctx.lineWidth = 1;
    ctx.globalAlpha = 1;
    ctx.strokeStyle = colors.line;
    ctx.stroke(outerPath);
    ctx.globalAlpha = 0.4;
    ctx.strokeStyle = colors.accent;
    ctx.stroke(innerPath);

    // Keep only a soft pool of contours around the minimum.
    const cx = surface.min.x * H;
    const cy = surface.min.y * H;
    const pool = ctx.createRadialGradient(cx, cy, 0, cx, cy, POOL * H);
    pool.addColorStop(0, '#000');
    pool.addColorStop(1, `rgba(0, 0, 0, ${POOL_EDGE})`);
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'destination-in';
    ctx.fillStyle = pool;
    ctx.fillRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'source-over';

    // Trail: older segments fade out.
    const pts = [...trail, at];
    ctx.strokeStyle = colors.accent;
    ctx.lineWidth = 1;
    ctx.lineCap = 'round';
    for (let i = 1; i < pts.length; i++) {
      ctx.globalAlpha = (i / pts.length) * 0.35;
      ctx.beginPath();
      ctx.moveTo(pts[i - 1].x * H, pts[i - 1].y * H);
      ctx.lineTo(pts[i].x * H, pts[i].y * H);
      ctx.stroke();
    }

    ctx.fillStyle = colors.accent;
    ctx.globalAlpha = 0.75;
    ctx.beginPath();
    ctx.arc(at.x * H, at.y * H, 3.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  const fmtLr = (x: number) => (x < 0.01 ? x.toExponential() : `${+x.toPrecision(3)}`);
  function updateStats() {
    stats.textContent = `loss ${Math.max(0, loss(surface, ball.p)).toFixed(3)} · lr ${fmtLr(lr)} · step ${stepCount.toLocaleString('en-US')}`;
  }

  function advance() {
    prev = ball.p;
    step(surface, ball, lr, aspect);
    trail.push(ball.p);
    if (trail.length > TRAIL) trail.shift();
    stepCount++;
  }

  // ---- reduced motion: one still frame with the whole path ------------------
  function drawStill() {
    if (!W && !resize()) return;
    surface.min = home();
    ball.p = { x: aspect * 0.15, y: 0.2 };
    ball.v = { x: 0, y: 0 };
    stepCount = 0;
    const path: Vec[] = [ball.p];
    for (let i = 0; i < 240; i++) {
      advance();
      path.push(ball.p);
    }
    trail.splice(0, trail.length, ...path.slice(-TRAIL * 3));
    draw(ball.p);
    updateStats();
  }

  // ---- animation loop --------------------------------------------------------
  const DT = 1 / STEPS_PER_SECOND;
  let raf = 0;
  let last = 0;
  let acc = 0;
  let still = 0; // consecutive steps with the ball at rest
  let visible = true;

  function frame(now: number) {
    raf = 0;
    const dt = Math.min(0.1, Math.max(0, (now - last) / 1000));
    last = now;

    // The minimum glides toward the cursor, so contours drift instead of jumping.
    const t = target();
    const ease = 1 - Math.exp(-dt * GLIDE);
    surface.min = {
      x: surface.min.x + (t.x - surface.min.x) * ease,
      y: surface.min.y + (t.y - surface.min.y) * ease,
    };
    const minMoving = Math.hypot(t.x - surface.min.x, t.y - surface.min.y) > 1e-4;
    if (!minMoving) surface.min = { ...t };

    acc += dt;
    while (acc >= DT) {
      advance();
      acc -= DT;
      const atRest =
        Math.hypot(ball.v.x, ball.v.y) < 2e-4 &&
        Math.hypot(ball.p.x - surface.min.x, ball.p.y - surface.min.y) < 2e-3;
      still = atRest && !minMoving ? still + 1 : 0;
    }
    const f = acc / DT;
    draw({ x: prev.x + (ball.p.x - prev.x) * f, y: prev.y + (ball.p.y - prev.y) * f });
    updateStats();
    // Sleep once the ball has settled and its trail has faded.
    if (still < TRAIL) schedule();
  }

  function schedule() {
    if (raf || !wide.matches || !visible || document.hidden || !W) return;
    if (reduced) return drawStill();
    last = performance.now();
    still = 0;
    raf = requestAnimationFrame(frame);
  }

  // ---- input ---------------------------------------------------------------
  function toHero(x: number, y: number): Vec | null {
    const r = hero.getBoundingClientRect();
    if (x < r.left || x > r.right || y < r.top || y > r.bottom) return null;
    return { x: (x - r.left) / H, y: (y - r.top) / H };
  }

  if (!reduced) {
    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        mouse = toHero(e.clientX, e.clientY);
        schedule();
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () => {
      mouse = null;
      schedule();
    });
    // Touch: a tap in the hero moves the minimum there.
    hero.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tap = toHero(e.clientX, e.clientY);
      schedule();
    });
  }

  document.addEventListener(LR_EVENT, (e) => {
    lr = (e as CustomEvent<number>).detail;
    // A small kick, so the new learning rate shows even when the ball is at rest.
    const a = Math.random() * Math.PI * 2;
    ball.v = { x: ball.v.x + 0.02 * Math.cos(a), y: ball.v.y + 0.02 * Math.sin(a) };
    if (reduced) drawStill();
    else schedule();
  });

  document.documentElement.addEventListener(THEME_CHANGE_EVENT, () => {
    readColors();
    if (reduced) drawStill();
    else if (!raf) draw(ball.p);
  });

  document.addEventListener('visibilitychange', schedule);
  new IntersectionObserver((entries) => {
    visible = entries[0].isIntersecting;
    schedule();
  }).observe(hero);
  new ResizeObserver(() => {
    if (!resize()) return;
    if (reduced) drawStill();
    else {
      draw(ball.p);
      schedule();
    }
  }).observe(hero);

  readColors();
  if (resize()) {
    updateStats();
    schedule();
  }
</script>
