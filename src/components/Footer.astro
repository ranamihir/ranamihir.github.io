---
import { site } from '../data/site';
import Reveal from './Reveal.astro';
import ContactIcons from './ContactIcons.astro';
import { encodeEmail } from '../lib/email';

const year = new Date().getFullYear();
---

<footer id="contact" class="bg-footer text-on-footer">
  <div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-28">
    <!-- CTA -->
    <Reveal>
      <p class="eyebrow text-on-footer/55">Contact</p>
      <h2 class="mt-5 max-w-3xl font-serif text-on-footer text-hero leading-[1.04]">
        Say <span class="italic text-accent">hello.</span>
      </h2>
      <p class="mt-8 font-serif text-2xl text-on-footer md:text-3xl">
        <!-- Address is filled in by revealEmails(); "Email me" is the no-JS fallback. -->
        <a
          href="#contact"
          data-email={encodeEmail(site.email)}
          data-email-text
          class="link-underline hover:text-accent"
        >
          Email me
        </a>
      </p>
    </Reveal>

    <!-- Bottom bar -->
    <div class="mt-16 flex flex-col gap-4 border-t border-on-footer/12 pt-6 text-sm text-on-footer/55 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}
      </p>
      <ContactIcons linkClass="text-on-footer/70 hover:text-on-footer" />
      <a href="#top" class="link-underline text-on-footer/80 hover:text-on-footer">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
