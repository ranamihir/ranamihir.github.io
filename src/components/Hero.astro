---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import ContactIcons from './ContactIcons.astro';
import Icon from './Icon.astro';
import { inlineMarkup } from '../lib/text';
---

<section id="about" class="relative">
  <div class="mx-auto max-w-6xl px-6 pt-32 pb-20 md:px-10 md:pt-40 md:pb-28">
    <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16 lg:gap-20">
      <!-- Portrait: first on mobile, right column on desktop. Above the fold, so
           it rises in with a transform only: never hidden, never delays LCP. -->
      <figure class="hero-rise relative order-first w-full max-w-[15rem] [animation-delay:120ms] sm:max-w-[18rem] md:order-last md:ml-auto md:max-w-[24rem]">
        <!-- Offset accent frame behind the photo -->
        <div
          class="absolute inset-0 translate-x-3 translate-y-3 rounded-[1.75rem] bg-accent-soft md:translate-x-4 md:translate-y-4"
          aria-hidden="true"
        ></div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] border border-line bg-paper-2">
          <Picture
            src={site.portrait}
            alt={`Portrait of ${site.name}`}
            formats={['avif', 'webp']}
            widths={[240, 384, 576, 768]}
            sizes="(min-width: 768px) 24rem, (min-width: 640px) 18rem, 15rem"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
      </figure>

      <div>
        <div class="hero-rise">
          <!-- The "/" hangs in the column gap to the left of the location. When the
               location wraps onto its own line, the slash falls outside the box and
               overflow-hidden clips it, so it only shows when both share a line. -->
          <p class="eyebrow flex flex-wrap items-center gap-x-5 gap-y-2 overflow-hidden">
            <span class="inline-flex flex-wrap items-center gap-x-2 gap-y-2">
              <span>{site.title} at</span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-chip px-2.5 py-1 text-[0.9rem] font-semibold tracking-normal text-ink normal-case">
                <Icon name="meta" class="h-[1.15em] w-[1.15em] text-meta" />
                {site.employer}
              </span>
            </span>
            <span class="relative">
              <span class="absolute right-full w-5 text-center text-line" aria-hidden="true">
                /
              </span>
              {site.location}
            </span>
          </p>
        </div>

        <div class="hero-rise [animation-delay:80ms]">
          <h1 class="mt-6 font-serif text-hero text-ink">{site.greeting}</h1>
          <p class="mt-4 max-w-xl font-serif text-aside italic text-ink-soft">{site.aside}</p>
        </div>

        <div class="hero-rise mt-8 [animation-delay:160ms] max-w-xl space-y-4 text-[1.05rem] leading-relaxed text-ink-soft">
          {site.bio.map((p) => (
            <p set:html={inlineMarkup(p)} />
          ))}
        </div>

        <div class="hero-rise mt-8 [animation-delay:220ms] flex flex-wrap items-center gap-x-6 gap-y-3">
          <ContactIcons iconClass="h-[1.3rem] w-[1.3rem]" />
          <a
            href="#terminal"
            class="group inline-flex items-center gap-2 rounded-full border border-line bg-chip px-3.5 py-1.5 font-mono text-[0.8rem] text-ink-soft transition-colors hover:border-accent hover:text-ink"
          >
            <span class="text-accent" aria-hidden="true">
              &gt;_
            </span>
            Prefer a terminal?
            <span class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">
              ↓
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
