---
// Thin wrapper that opts an element into the scroll-reveal animation.
// Usage: <Reveal delay={120}> ... </Reveal>
// The delay travels as a data attribute (not an inline style, which the CSP
// forbids); the reveal script in BaseLayout applies it.
interface Props {
  delay?: number;
  class?: string;
}
const { delay = 0, class: className } = Astro.props;
---

<div data-reveal data-reveal-delay={delay || undefined} class={className}>
  <slot />
</div>
